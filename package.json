{
  "name": "mingwsync",
  "displayName": "MingwSync",
  "description": "Smart MinGW-w64 package manager and compiler toolchain for VS Code",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Other",
    "Build",
    "Programming Languages"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "mingwsync.detectToolchain",
        "title": "MingwSync: Detect MinGW-w64 Toolchain"
      },
      {
        "command": "mingwsync.configureProject",
        "title": "MingwSync: Configure Project Dependencies"
      },
      {
        "command": "mingwsync.buildPortable",
        "title": "MingwSync: Build Portable Executable (Static Link)"
      },
      {
        "command": "mingwsync.showDependencyGraph",
        "title": "MingwSync: Show Dependency Graph"
      },
      {
        "command": "mingwsync.analyzeBloat",
        "title": "MingwSync: Analyze Executable Bloat"
      },
      {
        "command": "mingwsync.upgradeToolchain",
        "title": "MingwSync: Upgrade Toolchain"
      },
      {
        "command": "mingwsync.installMissingLibrary",
        "title": "MingwSync: Install Missing Library"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.70.0",
    "@typescript-eslint/eslint-plugin": "^5.40.0",
    "@typescript-eslint/parser": "^5.40.0",
    "eslint": "^8.25.0",
    "typescript": "^4.8.4"
  },
  "dependencies": {
    "minimatch": "^5.1.0"
  }
}
